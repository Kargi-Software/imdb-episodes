{"tt35047338":"Sub rosa.","tt35273601":"Exitus acta probat.","tt35341701":"Quid faciam?","tt35341708":"Acta est fabula.","tt35341709":"Facta fugis, facienda petis.","tt35341711":"Animum reges.","tt35341712":"Ne vivam si abis.","tt35341713":"Post nubila Phoebus.","tt35341714":"Belua multorum es capitum.","tt35341718":"Odi et amo.","tt35341720":"Fluctuat nec mergitur.","tt35341721":"Te ustus amen.","tt35341722":"Per aspera ad astra."}